{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".tmp-test",
    "rootDir": ".",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": false,
    "types": ["node", "mocha", "chai"]
